# ==============================================================================
# SmartCity Guardian — Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL RUNTIME CONFIGURATION.
# NEVER COMMIT ACTUAL SECRETS, CREDENTIALS, OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Core Operational Mode
# When MOCK_MODE=true, the system runs safely without external API dependencies,
# utilizing realistic simulated data for weather, traffic, Grok AI, and SMS.
MOCK_MODE=true

# Database Persistence (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://smartcity:smartcity_secret@localhost:5432/smartcity_db
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# In-Memory Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_minimum_32_character_random_secret_string
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=replace_with_another_secure_minimum_32_character_secret_string
JWT_REFRESH_EXPIRES_IN=604800

# Grok AI Decision Support (xAI API)
GROK_API_KEY=xai-your-grok-api-key-here
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
GROK_TIMEOUT_MS=5000
GROK_MAX_RETRIES=2
GROK_ENABLED=true

# Environmental Data Provider (Open-Meteo / NOAA / Custom)
WEATHER_PROVIDER=mock
WEATHER_API_KEY=your-weather-api-key-if-required
WEATHER_POLL_INTERVAL_SECONDS=300

# Traffic Flow & Incidents Provider (TomTom / Mapbox / Mock)
TRAFFIC_PROVIDER=mock
TRAFFIC_API_KEY=your-traffic-api-key-here
TRAFFIC_POLL_INTERVAL_SECONDS=180

# Mapping & Routing Provider (OSRM / Mapbox / Mock)
MAP_PROVIDER=mock
MAP_API_KEY=your-map-api-key-here
ROUTING_ENGINE_URL=http://router.project-osrm.org

# SMS Emergency Alerts Provider (TextBee / Fast2SMS / Twilio / Mock)
SMS_PROVIDER=mock
TEXTBEE_API_KEY=your-textbee-api-key-here
TEXTBEE_DEVICE_ID=your-textbee-device-id-optional
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_TEST_MODE=true
FAST2SMS_API_KEY=your-fast2sms-api-key-here
SMS_API_KEY=your-sms-api-key-or-auth-token
SMS_ACCOUNT_SID=your-twilio-account-sid
SMS_SENDER_NUMBER=+15551234567

# Location-Based Alerts & Mobility Relevance
ALERT_RADIUS_KM=10
LOCATION_UPDATE_INTERVAL_SECONDS=60
LOCATION_MIN_MOVEMENT_METERS=250

# Multilingual Foundation (en, hi, kn)
DEFAULT_LANGUAGE=en

# Real-Time Telemetry & Rate Limiting
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
