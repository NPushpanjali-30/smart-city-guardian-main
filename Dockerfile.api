# ==============================================================================
# Multi-Stage Production Dockerfile for SmartCity Guardian API Service
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Dependencies & Compile TypeScript
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy workspace package manifests
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/api/package*.json ./apps/api/
COPY apps/web/package*.json ./apps/web/

# Install all dependencies (including devDependencies for compiling)
RUN npm ci

# Copy full source tree
COPY packages/shared/ ./packages/shared/
COPY apps/api/ ./apps/api/
COPY tsconfig.base.json ./

# Build shared library and API service
RUN npm --prefix packages/shared run build
RUN npm --prefix apps/api run build

# Prune dev dependencies for lean production deployment
RUN npm prune --production

# ------------------------------------------------------------------------------
# Stage 2: Hardened Production Runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

# Install curl for container healthchecks
RUN apk add --no-cache curl

# Create unprivileged system user and group
RUN addgroup -S smartcity && adduser -S smartcity -G smartcity

# Copy production artifacts from builder
COPY --from=builder --chown=smartcity:smartcity /app/package*.json ./
COPY --from=builder --chown=smartcity:smartcity /app/node_modules ./node_modules
COPY --from=builder --chown=smartcity:smartcity /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=smartcity:smartcity /app/packages/shared/package*.json ./packages/shared/
COPY --from=builder --chown=smartcity:smartcity /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=smartcity:smartcity /app/apps/api/package*.json ./apps/api/

# Switch to unprivileged runtime user
USER smartcity

EXPOSE 4000

# Docker native container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:4000/health/live || exit 1

# Launch production server
CMD ["node", "apps/api/dist/index.js"]
